region                   = "eu-west-1"
owner                    = "your-team"
api_origin_hostname      = "api.your-domain.example"
api_certificate_arn      = "REPLACE_WITH_REGIONAL_ACM_CERTIFICATE_ARN"
frontend_hostname        = ""
frontend_certificate_arn = "" # A custom frontend name needs a us-east-1 ACM certificate.
route53_zone_id           = ""
bedrock_model_id          = "REPLACE_WITH_ENABLED_MODEL_OR_INFERENCE_PROFILE"
bedrock_resource_arns     = ["REPLACE_WITH_APPROVED_MODEL_AND_PROFILE_ARNS"]
search_api_url            = "https://your-approved-search-api.example/search"
approved_fetch_domains   = ""
desired_count            = 0 # Set after images, database grants, secrets and migrations are ready.
worker_desired_count     = 0
db_multi_az               = true
db_instance_class         = "db.t4g.small"
nat_strategy              = "per_az"
image_tag                 = "REPLACE_WITH_REVIEWED_COMMIT_SHA"
alarm_actions             = []
